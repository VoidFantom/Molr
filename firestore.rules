rules_version = '2';
service cloud.firestore {
  match /databases/{database}/documents {
    
    // Default deny all to prevent accidental exposure
    match /{document=**} {
      allow read, write: if false;
    }

    // 1. User Documents
    // Users can only read and write their own profile/streak data
    match /users/{userId} {
      allow read, write: if request.auth != null && request.auth.uid == userId;
    }

    // 2. User Progress & Backlogs
    // Matches backlogs/{userId} and any subcollections (like items/{itemId} and dailySnapshots/{date})
    match /backlogs/{userId}/{document=**} {
      allow read, write: if request.auth != null && request.auth.uid == userId;
    }

    // 3. Shared Content (Read-Only)
    // Logged-in users can read, but only admins/backend can write
    match /subjects/{document=**} {
      allow read: if request.auth != null;
      allow write: if false; 
    }

    match /chapters/{document=**} {
      allow read: if request.auth != null;
      allow write: if false; 
    }

    match /notes/{document=**} {
      allow read: if request.auth != null;
      allow write: if false; 
    }
  }
}
